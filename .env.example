# enough. — frontend configuration
# Copy this file to .env and fill in the values from your Supabase project.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable key (safe to use in the browser when RLS is enabled).
# Newer projects call this the "publishable" key; older projects call it the
# "anon" key. Either value is fine here — this is NOT the secret/service-role key.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy fallback: if your project only provides an "anon" key, set this instead.
# Only one of the two keys above/below is required.
# VITE_SUPABASE_ANON_KEY=

# Not a frontend variable: the contact-form Edge Function reads server-side
# secrets instead, and `ALLOWED_ORIGIN` is one of them. It is listed here only
# so the name is discoverable — set it with `supabase secrets set`, never in
# this file, and never as a `VITE_*` variable (everything in a .env file that
# Vite reads is shipped to every visitor of the site).
#
#   ALLOWED_ORIGIN=https://chat.example.com   exact origin allowed to call
#                                             send-contact-email (self-hosting)
