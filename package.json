{
  "name": "enough",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "smoke": "node --experimental-strip-types scripts/smoke-test.mjs",
    "test:crypto": "node --test --experimental-strip-types src/lib/crypto/__tests__/crypto.test.mjs src/lib/crypto/__tests__/keys.test.mjs src/lib/crypto/__tests__/primitives.test.mjs src/lib/crypto/__tests__/revision.test.mjs src/lib/crypto/__tests__/sealed-state.test.mjs src/lib/crypto/__tests__/ratchet-state.test.mjs src/lib/crypto/__tests__/migration.test.mjs src/lib/e2ee/__tests__/device-store.test.mjs src/lib/e2ee/__tests__/message-flow.test.mjs src/lib/e2ee/__tests__/message-cache.test.mjs src/lib/e2ee/__tests__/session-lifecycle.test.mjs",
    "test:crypto:engine": "node --test --experimental-strip-types src/lib/e2ee/__tests__/engine-adapter.test.mjs src/lib/e2ee/__tests__/session-manager.test.mjs src/lib/e2ee/__tests__/signed-prekey-rotation.test.mjs src/lib/crypto/__tests__/real-engine.integration.test.mjs",
    "test:i18n": "node --test --experimental-strip-types src/i18n/__tests__/i18n.test.mjs",
    "test:settings": "node --test --experimental-strip-types src/lib/__tests__/settings-people.test.mjs",
    "test:input": "node --test --experimental-strip-types src/lib/__tests__/input-hardening.test.mjs",
    "test:unread": "node --test --experimental-strip-types src/lib/__tests__/unread-counts.test.mjs",
    "test:scroll": "node --test --experimental-strip-types src/lib/__tests__/chat-scroll.test.mjs",
    "test:contrast": "node --test --experimental-strip-types src/lib/__tests__/scroll-down-contrast.test.mjs",
    "test:read": "node --test --experimental-strip-types src/lib/__tests__/read-position.test.mjs",
    "test:home": "node --test --experimental-strip-types src/lib/__tests__/home-realtime.test.mjs src/lib/__tests__/home-long-press.test.mjs",
    "test:preview": "node --test --experimental-strip-types src/lib/__tests__/home-preview.test.mjs",
    "test:helpers": "node --test --experimental-strip-types src/lib/__tests__/helpers.test.mjs",
    "test:chatblocks": "node --test --experimental-strip-types src/lib/__tests__/chat-block-channel.test.mjs",
    "test:blocked": "node --test src/lib/__tests__/blocked-composer.test.mjs",
    "test:api-errors": "node --test src/lib/__tests__/api-error-surface.test.mjs",
    "test:api": "node --test --experimental-strip-types src/lib/__tests__/api.test.mjs",
    "test:errors": "node --test --experimental-strip-types src/lib/__tests__/errors.test.mjs",
    "test:a11y": "node --test --experimental-strip-types src/lib/__tests__/accessibility.test.mjs",
    "test:crypto:prekeys": "node scripts/run-crypto-prekeys-tests.mjs",
    "test:rls": "node scripts/run-rls-tests.mjs",
    "verify:signal-wasm": "node scripts/verify-signal-wasm.mjs"
  },
  "dependencies": {
    "@getmaapp/signal-wasm": "0.6.6",
    "@supabase/supabase-js": "^2.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "embedded-postgres": "^18.4.0-beta.17",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^24.1.3",
    "pg": "^8.16.3",
    "typescript": "^5.7.2",
    "vite": "^6.4.3"
  }
